# "mock" (default) keeps all data in the browser, no backend needed.
# "firebase" uses Firebase Auth, Firestore and Storage, as described in README.md.
NEXT_PUBLIC_DATA_SOURCE=mock

# Firebase console > Project settings > General > Your apps > Web app. Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Usually <project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Firebase console > Project settings > Service accounts > Generate new private key.
# Copy the three fields from the downloaded JSON. Keep the private key on one line with \n in it.
# Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mock mode only: emails that sign in as Vendii ops staff (comma separated).
NEXT_PUBLIC_OPS_EMAILS=ops@dividendi.ng

# ---- Pilot (Coronation + First registrars). Step-by-step: SETUP.md ----

# Where the records live. Create the tables with supabase/pilot.sql (SETUP.md, part 1).
# Supabase > Project Settings > API. The service-role key is a SECRET: server only, never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Who may open /admin. Each must also have a user in Supabase > Authentication > Users. Comma separated.
PILOT_ADMIN_EMAILS=info@rinwahospitality.com

# "test" (the default if unset): every registrar email goes to PILOT_TEST_EMAIL instead. "live": goes to the registrar.
PILOT_MODE=test
PILOT_TEST_EMAIL=info@rinwahospitality.com
# Gets a blind copy of every live registrar email.
PILOT_ADMIN_EMAIL=info@rinwahospitality.com
# Registrars' replies go here.
PILOT_REPLY_TO=info@rinwahospitality.com

# Step 1 email check. "demo" (default): the code is always 123456 and no email is sent. "email": a random code is emailed.
PILOT_OTP=demo
# Signs the proof that an email was confirmed. Any long random string (32+ characters). Required when PILOT_MODE=live.
PILOT_SECRET=

# Outgoing mail. Any SMTP account works (Zoho, Google Workspace, Brevo, Resend, Postmark ...).
MAIL_FROM="Vendii <dami@dividendii.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Shown to people who choose "pay ahead".
PILOT_PAY_BANK=
PILOT_PAY_ACCOUNT_NAME=
PILOT_PAY_ACCOUNT_NUMBER=
