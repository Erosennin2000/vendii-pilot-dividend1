rules_version = '2';

// Clients never write to Firestore. Every change goes through the Next.js routes in
// app/api, which run as the service account and enforce the claim state machine.
// These rules only decide who can read what.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOps() { return signedIn() && request.auth.token.role == 'ops'; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }

    // Register data is only reachable through /api/search, which needs a name to match.
    match /registerEntries/{id} {
      allow read, write: if false;
    }

    // BVN, NIN, bank details and the signed authority. Owner and staff only.
    match /filings/{id} {
      allow read: if owns(resource.data) || isOps();
      allow write: if false;
    }

    match /claims/{id} {
      allow read: if owns(resource.data) || isOps();
      allow write: if false;
    }

    match /feeDebits/{claimId} {
      allow read: if owns(resource.data) || isOps();
      allow write: if false;
    }

    // Pilot submissions hold BVNs and bank details. Staff read only; the server writes.
    match /pilotSubmissions/{id} {
      allow read: if isOps();
      allow write: if false;
    }

    match /outboundMessages/{id} {
      allow read: if isOps();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
